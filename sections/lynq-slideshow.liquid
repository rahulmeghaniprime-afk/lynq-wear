<div class="wrapper-{{ section.id }}">
    <div class="slide_show">
        <div class="slide_show_wrapper">
            <div class="swiper">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {% if block.settings.image != blank %}
                            <div class="swiper-slide">
                                {{
                                    block.settings.image
                                    | image_url: width: 2880
                                    | image_tag:
                                        widths: '480, 765, 900, 1000, 1200, 1500, 2000, 2880',
                                        sizes: '100vw',
                                        class: 'blur-up img-fluid',
                                        loading: forloop.first
                                    | default: false
                                    | ternary: 'eager',
                                        'lazy',
                                        fetchpriority: forloop.first
                                    | default: false
                                    | ternary: 'high', 'auto', alt: img.alt
                                    | escape
                                }}
                            </div>
                        {% else %}
                            <div class="swiper-slide">
                                {{ 'lifestyle-1' | placeholder_svg_tag }}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="swiper-pagination"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-scrollbar"></div>
            </div>
        </div>
    </div>
</div>
<script defer="defer">
    const swiper = new Swiper('.wrapper-{{ section.id }} .swiper', {
        // Optional parameters
        direction: 'vertical',
        loop: true,

        // If we need pagination
        pagination: {
            el: '.wrapper-{{ section.id }} .swiper-pagination',
        },

        // Navigation arrows
        navigation: {
            nextEl: '.wrapper-{{ section.id }} .swiper-button-next',
            prevEl: '.wrapper-{{ section.id }} .swiper-button-prev',
        },

        // And if we need scrollbar
        scrollbar: {
            el: '.wrapper-{{ section.id }} .swiper-scrollbar',
        },
    });
</script>
{%- schema -%}
{
    "name": "Slide Show",
    "settings": [],
    "blocks": [
        {
            "name": "Slide",
            "type": "slide",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Select Image"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Slide Show",
            "blocks": [
                {
                    "type": "slide"
                },
                {
                    "type": "slide"
                }
            ]
        }
    ]
}
{%- endschema -%}
