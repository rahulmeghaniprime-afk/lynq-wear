
<div class="dev-product-tabs" id="ProductInfoTabs-{{ section.id }}">
  <div class="dev-product-tabs__nav" role="tablist" aria-label="Product information">

    <button
      type="button"
      class="dev-product-tabs__button is-active"
      role="tab"
      id="tab-description-{{ section.id }}"
      aria-controls="panel-description-{{ section.id }}"
      aria-selected="true"
      data-tab="description">
      DESCRIPTION
    </button>

    <button
      type="button"
      class="dev-product-tabs__button"
      role="tab"
      id="tab-manufacturer-{{ section.id }}"
      aria-controls="panel-manufacturer-{{ section.id }}"
      aria-selected="false"
      tabindex="-1"
      data-tab="manufacturer">
      MANUFACTURER DETAILS
    </button>

    <button
      type="button"
      class="dev-product-tabs__button"
      role="tab"
      id="tab-shipping-{{ section.id }}"
      aria-controls="panel-shipping-{{ section.id }}"
      aria-selected="false"
      tabindex="-1"
      data-tab="shipping">
      SHIPPING, RETURN AND EXCHANGE
    </button>

  </div>

  <div
    class="dev-product-tabs__panel rte"
    id="panel-description-{{ section.id }}"
    role="tabpanel"
    aria-labelledby="tab-description-{{ section.id }}">
    {{ product.description }}
  </div>

  <div
    class="dev-product-tabs__panel rte"
    id="panel-manufacturer-{{ section.id }}"
    role="tabpanel"
    aria-labelledby="tab-manufacturer-{{ section.id }}"
    hidden>

    <h3>Manufacturer Details</h3>
    <p><strong>Brand:</strong> {{ product.vendor | escape }}</p>
    <p><strong>Product:</strong> {{ product.title | escape }}</p>
    <p>Replace this content with your manufacturer details.</p>

  </div>

  <div
    class="dev-product-tabs__panel rte"
    id="panel-shipping-{{ section.id }}"
    role="tabpanel"
    aria-labelledby="tab-shipping-{{ section.id }}"
    hidden>

    <h3>Shipping, Return and Exchange</h3>
    <p>Shipping timelines, return policies and exchange information.</p>
    <p>Replace this content with your store's actual shipping and return policy.</p>

  </div>
</div>

<style>
  #ProductInfoTabs-{{ section.id }} {
    width: 100%;
    margin-top: 35px;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__nav {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 25px;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 20px;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__button {
    position: relative;
    flex: 0 0 auto;
    padding: 0 0 12px;
    border: 0;
    background: transparent;
    color: #222;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__button.is-active {
    font-weight: 700;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__button.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: #000;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__panel {
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__panel[hidden] {
    display: none !important;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__panel h3 {
    font-size: 16px;
    margin-top: 0;
  }

  #ProductInfoTabs-{{ section.id }} .dev-product-tabs__button:focus-visible {
    outline: 2px solid #000;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    #ProductInfoTabs-{{ section.id }} .dev-product-tabs__nav {
      gap: 22px;
      overflow-x: auto;
      justify-content: flex-start;
      scrollbar-width: thin;
    }

    #ProductInfoTabs-{{ section.id }} .dev-product-tabs__button {
      font-size: 12px;
    }

    #ProductInfoTabs-{{ section.id }} {
      margin-top: 25px;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById(
      'ProductInfoTabs-{{ section.id }}'
    );

    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const buttons = Array.from(
      root.querySelectorAll('[role="tab"]')
    );

    const panels = Array.from(
      root.querySelectorAll('[role="tabpanel"]')
    );

    function activateTab(button, focus = false) {
      const target = button.dataset.tab;

      buttons.forEach((btn) => {
        const active = btn === button;

        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', String(active));
        btn.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = !panel.id.endsWith(
          '-' + target + '-{{ section.id }}'
        );
      });

      if (focus) button.focus();
    }

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        activateTab(button);
      });

      button.addEventListener('keydown', (event) => {
        let nextIndex = index;

        if (event.key === 'ArrowRight') {
          nextIndex = (index + 1) % buttons.length;
        } else if (event.key === 'ArrowLeft') {
          nextIndex = (index - 1 + buttons.length) % buttons.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = buttons.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        activateTab(buttons[nextIndex], true);
      });
    });
  })();
</script>
